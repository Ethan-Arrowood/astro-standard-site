{
  "name": "@arrowood.dev/astro-standard-site",
  "version": "0.1.0",
  "description": "Astro integration that publishes your site to the ATmosphere using Standard.site lexicons.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ethan-Arrowood/astro-standard-site.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp astro-standard-site.d.ts dist/",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "keywords": [
    "astro-integration",
    "withastro",
    "astro",
    "atproto",
    "bluesky",
    "standard.site"
  ],
  "exports": {
    ".": {
      "types": "./dist/standardSiteIntegration.d.ts",
      "default": "./dist/standardSiteIntegration.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "astro-standard-site-keys": "./dist/keys.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "dependencies": {
    "@atproto/lex": "0.4.7",
    "@atproto/lex-password-session": "0.3.2",
    "@atproto/syntax": "0.7.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "astro": "7.4.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
